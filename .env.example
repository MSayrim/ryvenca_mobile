# Base URL of the RYVENCA Spring Boot backend (no trailing slash).
#   iOS simulator / web:      http://localhost:8080
#   Android emulator:         http://10.0.2.2:8080
#   Physical device (Expo Go): http://<your-computer-LAN-IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: Google Sign-In web client id (normally read from firebase/google-services.json, client_type 3).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
